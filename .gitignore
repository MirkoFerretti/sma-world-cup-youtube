# Environment files
.env
.venv/
venv/

# Python cache and build artifacts
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Notebook artifacts
.ipynb_checkpoints/

# Local tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs and local databases
*.log
*.db
*.sqlite

# Raw and generated data
data/raw/*
data/processed/*
data/final/*
outputs/figures/*
outputs/tables/*
outputs/networks/*

# Keep placeholders
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/final/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!outputs/networks/.gitkeep
!metadata/.gitkeep
!report/.gitkeep
